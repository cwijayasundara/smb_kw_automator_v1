# Keel backend settings. Copy to backend/.env and edit. Every setting is listed with its default.
# Uncommented lines work as-is for a local, fully offline run (no API keys, local rules extractor).
# Environment variables override this file. Never commit backend/.env.
#
# KEYS YOU NEED
#   To run at all ......... none. The two database URLs below work with `make db` / init-db.sql.
#   Real AI (live mode) ... GOOGLE_API_KEY   document parsing, including handwriting re-reads
#                           OPENAI_API_KEY / FIREWORKS_API_KEY   routed Ask Keel tasks
#   Optional .............. REDUCTO_API_KEY / VISION_AGENT_API_KEY (tier-4 parsers, off by default)
#                           LANGFUSE_PUBLIC_KEY + LANGFUSE_SECRET_KEY (tracing; local ones come from `make langfuse`)
#   Cloud (Cloud Run) ..... database URLs pointing at Neon; no storage keys (the service account reads
#                           the bucket). In the cloud these live in Secret Manager, not in a file:
#                           see infra/cloudrun/bootstrap.sh.
#   Optional Qwen ......... QWEN_API_KEY + KEEL_QWEN_BASE_URL, plus a priced YAML profile

# ── Runtime ───────────────────────────────────────────────────────────────────────────────────────
KEEL_ENV=dev                                   # dev | test | prod

# ── Database (Postgres 16+ with pgvector, pg_trgm, citext) ────────────────────────────────────────
# Two roles: the app runs as keel_app (cannot bypass row-level security); migrations run as keel_owner.
# In the cloud only the migrate job gets the owner URL. Neon: append ?sslmode=require
KEEL_DATABASE_URL=postgresql+psycopg://keel_app:keel_app@localhost:5432/keel
KEEL_DATABASE_OWNER_URL=postgresql+psycopg://keel_owner:keel_owner@localhost:5432/keel

# ── Files ─────────────────────────────────────────────────────────────────────────────────────────
KEEL_STORAGE_BACKEND=local                     # local | gcs
KEEL_STORAGE_DIR=./var/storage                 # local backend only
# KEEL_GCS_BUCKET=my-project-keel-files        # gcs backend; no keys: Cloud Run's service account
# KEEL_GCS_ENDPOINT=https://storage.googleapis.com   # locally: `gcloud auth application-default login`

# ── Web app and sessions ──────────────────────────────────────────────────────────────────────────
KEEL_FRONTEND_URL=http://localhost:3000        # used in magic-link and invite links
KEEL_COOKIE_SECURE=false                       # true in production (HTTPS)
# KEEL_SESSION_COOKIE=keel_session
# KEEL_SESSION_TTL_DAYS=30
# KEEL_MAGIC_LINK_TTL_MINUTES=20
# KEEL_INVITE_TTL_DAYS=7

# ── AI models ─────────────────────────────────────────────────────────────────────────────────────
KEEL_LLM_MODE=auto                             # auto (live if a supported key is set) | fake | live
# OPENAI_API_KEY=sk-...                        # GPT-6 Luna: Ask Keel; embeddings
# GOOGLE_API_KEY=...                           # Gemini 3.8 Flash: document parser (first pass and handwriting re-reads)
# KEEL_MODEL_DEFAULT=openai:gpt-6-luna
# KEEL_MODEL_PARSER=google_genai:gemini-3.8-flash   # first-pass document extraction
# KEEL_MODEL_VISION_HANDWRITING=google_genai:gemini-3.8-flash

# Models, prices, tiers, capabilities and provider parameters: keel/models.yml.
# .env overrides take precedence; a new model ID also needs a configured price.
# KEEL_MODEL_REGISTRY_PATH=/absolute/path/models.yml
# KEEL_ROUTER_MODE=enabled                    # enabled | shadow | off
# FIREWORKS_API_KEY=...
# KEEL_MODEL_GLM_FLASH=fireworks:accounts/fireworks/models/glm-5p3-flash
# KEEL_MODEL_DEEPSEEK_FLASH=fireworks:accounts/fireworks/models/deepseek-v4p1-flash
# KEEL_MODEL_BALANCED=openai:gpt-6-sol
# KEEL_ROUTER_MAX_OUTPUT_TOKENS=4096
# KEEL_ROUTER_TIMEOUT_SECONDS=60
# KEEL_ROUTER_MAX_FALLBACKS=2
# KEEL_ROUTER_MAX_UPGRADES=2
# KEEL_MONTHLY_AI_BUDGET_USD=10.0              # agent calls reserve budget atomically; all usage counts
# QWEN_API_KEY=...
# KEEL_QWEN_BASE_URL=https://your-approved-qwen-endpoint/v1
# KEEL_MODEL_PRICES={"your-model":{"input":"0.1","cached_input":"0.01","output":"0.5"}}

# ── Tier-4 parsers (off by default) ───────────────────────────────────────────────────────────────
# Only for pages still failing checks after the Gemini re-read. Pick per document type with
# `keel evals parsers`. Prices are placeholders: set them from your plan.
# KEEL_TIER4_ENGINE=reducto                    # reducto | ade | sol
# KEEL_TIER4_CONFIDENCE=0.85
# KEEL_MODEL_TIER4_SOL=openai:gpt-6-sol
# REDUCTO_API_KEY=...
# KEEL_REDUCTO_URL=https://platform.reducto.ai
# KEEL_REDUCTO_USD_PER_PAGE=0.02
# VISION_AGENT_API_KEY=...                     # LandingAI ADE
# KEEL_ADE_URL=https://api.va.landing.ai
# KEEL_ADE_USD_PER_PAGE=0.03

# ── Document reading and checks ───────────────────────────────────────────────────────────────────
# KEEL_OCR_ENABLED=true
# KEEL_MAX_UPLOAD_MB=25
# KEEL_LOW_CONFIDENCE=0.75                     # below this a field is flagged "check this"

# ── Search ────────────────────────────────────────────────────────────────────────────────────────
# KEEL_EMBEDDING_MODEL=text-embedding-3-small  # used only when OPENAI_API_KEY is set
# KEEL_EMBEDDING_DIMS=512
# KEEL_EMBEDDING_USD_PER_MTOK=0.02
# KEEL_CHUNK_CHARS=600                         # after changing: `keel reindex --all`
# KEEL_RRF_K=60
# KEEL_SEARCH_POOL=20
# KEEL_SEARCH_MIN_SIMILARITY=0.25              # "similar meaning" cosine floor
# KEEL_SEARCH_FUZZY=0.5                        # "close spelling" pg_trgm floor

# ── Worker ────────────────────────────────────────────────────────────────────────────────────────
# KEEL_WORKER_POLL_SECONDS=1.0
# KEEL_WORKER_DRAIN_MAX_SECONDS=50.0           # `keel worker --drain` (Cloud Run Job) stops by then

# ── Tracing (optional: `uv sync --extra observability`) ───────────────────────────────────────────
# All three are required (no URL = tracing off; Keel never falls back to Langfuse Cloud). Traces contain
# document text: point this at a Langfuse you control. `make langfuse-services` runs one
# locally on :3001 with these exact keys pre-created (with `make langfuse` the Docker stack is pre-wired).
# LANGFUSE_BASE_URL=http://localhost:3001
# LANGFUSE_PUBLIC_KEY=pk-lf-keel-local
# LANGFUSE_SECRET_KEY=sk-lf-keel-local

# ── Other tuning ─────────────────────────────────────────────────────────────────────────────────
# KEEL_UNUSUAL_QUANTITY_FACTOR=3.0
